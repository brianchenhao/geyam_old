# Geyam VPS reverse proxy.
#
# Phase 4: TLS terminated here using a Cloudflare Origin Certificate (pinned
# to the CF edge). Once Phase 5 enables the orange-cloud proxy on api.geyam.com,
# all traffic to this origin will arrive via Cloudflare's IP ranges and be
# encrypted end-to-end. Direct-IP requests from non-CF IPs will be rejected
# at the VPS firewall (Phase 5 step 7).

api.geyam.com {
    tls /opt/geyam/caddy/cf-origin.crt /opt/geyam/caddy/cf-origin.key

    # Phase 5 §7 — origin-firewall L7 enforcement.
    #
    # UFW alone can't fully implement the "non-CF refused" rule because
    # Docker port-publishing inserts PREROUTING DNAT rules that bypass
    # the INPUT chain. Caddy applies the same rule at L7: only TCP source
    # addresses inside Cloudflare's published ranges are allowed to reach
    # any handler. Direct-IP attackers TLS-handshake then get a flat 403.
    #
    # CF ranges are static (last expansion 2023). To refresh:
    #   curl -s https://www.cloudflare.com/ips-v4 https://www.cloudflare.com/ips-v6
    # then update the lists below and `docker compose restart caddy`.
    @not_cf {
        not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 \
                      103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 \
                      190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 \
                      198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
                      104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
                      2400:cb00::/32 2606:4700::/32 2803:f800::/32 \
                      2405:b500::/32 2405:8100::/32 2a06:98c0::/29 \
                      2c0f:f248::/32
    }
    handle @not_cf {
        respond "Direct origin access denied. Use https://api.geyam.com via Cloudflare." 403
    }

    encode gzip zstd

    header {
        # HSTS — once enabled, browsers refuse plaintext fallback for a year.
        # Safe because we know the cert chain (CF Origin → CF edge → CF cert).
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        # Strip Caddy's default Server: caddy banner from responses
        -Server
    }

    reverse_proxy backend:8000 {
        # Forward the real client IP so the backend (and Phase 7 antsilk
        # middleware) sees something useful. CF-Connecting-IP is the source
        # of truth once CF proxy is on; we pass it through unchanged.
        header_up X-Forwarded-For {http.request.remote.host}
        header_up X-Real-IP {http.request.remote.host}
        header_up CF-Connecting-IP {http.request.header.CF-Connecting-IP}
        header_up X-Forwarded-Proto https
        header_up Host {host}

        # Long timeouts for the menu-training upload + LLM ask paths.
        transport http {
            dial_timeout 10s
            response_header_timeout 60s
            read_timeout 120s
        }
    }

    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 5
        }
        format json
    }
}

# Plaintext on :80 — useful for direct-IP smoke tests during cutover dry-run
# (before DNS flips and CF proxy is on). Redirect to https in normal operation.
:80 {
    redir https://api.geyam.com{uri} permanent
}
