# Geyam VPS production environment template.
# Copy to .env.production on the VPS:
#   scp ops/.env.production.example deploy@geyam-prod:/opt/geyam/.env.production
# then edit in place to set real secrets. .env.production itself is gitignored
# (matches the repo's .env.* rule).

# ---------------- Postgres (Phase 2) ----------------
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=replace_with_64_char_random_token
POSTGRES_DB=geyam

# ---------------- Alembic / runtime (Phase 4 onwards) ----------------
# The hostname `geyam-db` resolves via the docker network created by
# `docker compose -p geyam up`.
# Async driver for the FastAPI app; sync driver for alembic in CI/migration shots.
DATABASE_URL=postgresql+asyncpg://pos_user:replace_with_64_char_random_token@geyam-db:5432/geyam
ALEMBIC_DATABASE_URL=postgresql+psycopg://pos_user:replace_with_64_char_random_token@geyam-db:5432/geyam

# ---------------- Stripe billing (Phase 9) ----------------
# Test mode keys begin with sk_test_ / pk_test_ / whsec_; live cutover (Phase 9
# step 11) is one env swap + container restart, no code change.
STRIPE_API_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Price IDs from the Stripe Dashboard → Products. Create three products
# (Free / Pro RM99 / Business RM299); only Pro and Business have prices.
STRIPE_PRICE_PRO=price_REPLACE_ME_PRO
STRIPE_PRICE_BUSINESS=price_REPLACE_ME_BUSINESS

# Where Stripe sends users after Checkout / Portal sessions complete.
STRIPE_CHECKOUT_SUCCESS_URL=https://app.geyam.com/billing/success
STRIPE_CHECKOUT_CANCEL_URL=https://app.geyam.com/billing/cancel
STRIPE_PORTAL_RETURN_URL=https://app.geyam.com/billing
