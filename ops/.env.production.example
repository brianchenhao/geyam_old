# Geyam VPS production environment template.
# Copy to .env.production on the VPS:
#   scp ops/.env.production.example deploy@geyam-prod:/opt/geyam/.env.production
# then edit in place to set real secrets. .env.production itself is gitignored
# (matches the repo's .env.* rule).

# ---------------- Postgres (Phase 2) ----------------
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=replace_with_64_char_random_token
POSTGRES_DB=geyam

# ---------------- Alembic / runtime (Phase 4 onwards) ----------------
# The hostname `geyam-db` resolves via the docker network created by
# `docker compose -p geyam up`.
# Async driver for the FastAPI app; sync driver for alembic in CI/migration shots.
DATABASE_URL=postgresql+asyncpg://pos_user:replace_with_64_char_random_token@geyam-db:5432/geyam
ALEMBIC_DATABASE_URL=postgresql+psycopg://pos_user:replace_with_64_char_random_token@geyam-db:5432/geyam
